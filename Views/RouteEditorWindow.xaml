<Window x:Class="windows_route_manager.Views.RouteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="490" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource SurfaceBrush}">
    <StackPanel Margin="28">
        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20" />
        <Label Content="_Destination prefix" Target="{Binding ElementName=DestinationBox}" />
        <TextBox x:Name="DestinationBox" Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding IsNew}" AutomationProperties.Name="Destination prefix" />
        <TextBlock Text="{Binding NormalizedPrefix}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,16" />
        <Label Content="Route _metric" Target="{Binding ElementName=MetricBox}" />
        <TextBox x:Name="MetricBox" Text="{Binding Metric, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Route metric" />
        <TextBlock Text="Whole number, 0–4294967295. Windows combines route and interface metrics when choosing a route."
                   TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,12" />
        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="#AE241D" Margin="0,0,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="_Cancel" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="_Save" IsDefault="True" Click="Save_Click" Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </StackPanel>
</Window>
