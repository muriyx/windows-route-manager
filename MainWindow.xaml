<Window x:Class="windows_route_manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Route Manager" Width="1100" Height="760" MinWidth="800" MinHeight="640"
        Background="#F4F6FA" WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding AddCommand}" />
    </Window.InputBindings>
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Windows Route Manager" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Windows IP &amp; VPN Route Manager" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="PrivilegeLabel" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" />
                <Button x:Name="ElevateButton" Content="Open as _administrator" Click="Elevate_Click" IsEnabled="{Binding IsIdle}" />
            </StackPanel>
        </Grid>
        <TabControl Grid.Row="1" SelectedIndex="0" Background="White" BorderBrush="#DCE3ED">
            <TabItem Header="VPN Routes">
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <Label Content="VPN _profile" Target="{Binding ElementName=ProfileBox}" Padding="0,0,0,8" FontWeight="SemiBold" />
                            <ComboBox x:Name="ProfileBox" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                      DisplayMemberPath="DisplayName" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="VPN profile" />
                            <TextBlock Text="{Binding ProfileDetails}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="_Refresh" Command="{Binding RefreshCommand}" ToolTip="Refresh profiles and saved routes (F5)" />
                            <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="8,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding CanCancel}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="#EEF4FF" CornerRadius="6" Padding="14,10" Margin="0,16,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding ProfileNotice}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <WrapPanel Grid.Row="2" Margin="0,0,0,12">
                        <CheckBox Content="_Split tunneling" IsChecked="{Binding SplitTunneling}" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <Button Content="_Apply setting" Command="{Binding ApplySplitCommand}" />
                        <TextBlock Text="Changes apply only after you click Apply." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,6,0,6" />
                    </WrapPanel>
                    <ScrollViewer Grid.Row="3" MaxHeight="72" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                        <TextBlock Text="{Binding Warnings}" Foreground="#8A4B0B" TextWrapping="Wrap" />
                    </ScrollViewer>
                    <Grid Grid.Row="4" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="_Add route" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}" ToolTip="Add route (Ctrl+N)" />
                            <Button Content="_Edit route" Command="{Binding EditCommand}" Margin="8,0,0,0" />
                            <Button Content="_Remove" Command="{Binding RemoveCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                            <Label Content="_Filter" Target="{Binding ElementName=FilterBox}" VerticalAlignment="Center" />
                            <TextBox x:Name="FilterBox" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Width="165"
                                     ToolTip="Filter by destination prefix or comment" AutomationProperties.Name="Filter routes by destination prefix or comment" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="5" MinHeight="90">
                        <DataGrid ItemsSource="{Binding Routes}" SelectedItem="{Binding SelectedRoute}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True"
                                  SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EDF0F5" BorderBrush="#DCE3ED" RowHeaderWidth="0"
                                  AlternatingRowBackground="#FAFBFD" IsEnabled="{Binding IsIdle}" EnableRowVirtualization="True"
                                  AutomationProperties.Name="Saved IPv4 VPN routes">
                            <DataGrid.InputBindings>
                                <KeyBinding Key="Delete" Command="{Binding RemoveCommand}" />
                                <KeyBinding Key="F2" Command="{Binding EditCommand}" />
                            </DataGrid.InputBindings>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Destination Prefix" Binding="{Binding DestinationPrefix}" Width="220" MinWidth="160" />
                                <DataGridTextColumn Header="Route Metric" Binding="{Binding Metric}" Width="120" />
                                <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="*" MinWidth="140">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding Comment}" />
                                            <Setter Property="MaxHeight" Value="40" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding EmptyMessage}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="22,42,22,12" Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding Routes.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Grid.Row="6" Text="{Binding RouteCount}" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" />
                </Grid>
            </TabItem>
            <TabItem Header="System Routes" />
        </TabControl>
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <ProgressBar Height="3" IsIndeterminate="{Binding IsBusy}" Margin="0,0,0,8">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Hidden" />
                        <Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
